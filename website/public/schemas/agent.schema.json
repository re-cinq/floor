{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The frontmatter of a floor agent file",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "description": "The model the agent runs on."
    },
    "image": {
      "type": "string",
      "description": "The container image the agent runs in. Required in a file that defines an agent."
    },
    "timeout_minutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "How long a visit may run, in minutes. Required in a file that defines an agent."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which cluster agents may run it. A cluster agent claims a visit only when it offers every tag."
    },
    "prices": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input_per_million": {
            "type": "number",
            "description": "US dollars for a million input tokens."
          },
          "output_per_million": {
            "type": "number",
            "description": "US dollars for a million output tokens."
          },
          "cache_read_per_million": {
            "type": "number",
            "description": "US dollars for a million tokens read from the cache. The input price when not stated."
          },
          "cache_write_per_million": {
            "type": "number",
            "description": "US dollars for a million tokens written to the cache. The input price when not stated."
          }
        },
        "required": [
          "input_per_million",
          "output_per_million"
        ],
        "additionalProperties": false
      },
      "description": "Model name to what it costs, for a model that reports tokens and no cost."
    },
    "config": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of the skills the agent is given."
        },
        "skills_source": {
          "type": "string",
          "format": "uri",
          "description": "Where the pod fetches each named skill and the agent's settings. Defaults to the floor's own `/skills`, which serves no skills."
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The name the agent knows the server by."
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ],
                "description": "How the server is reached. `stdio` is a process the pod starts. `http` and `sse` are an address it calls."
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "`stdio` only, and required there. The command that starts the server."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "`stdio` only. The command's arguments."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "`http` and `sse` only, and required there. The server's address."
              },
              "headers_secret": {
                "type": "string",
                "minLength": 1,
                "description": "The key of `agent-secrets` that holds one whole header line, such as `Authorization: Bearer <token>`."
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name of the header or environment variable."
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The key of the cluster's `agent-secrets` that holds its value."
                    }
                  },
                  "required": [
                    "name",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                "description": "`http` and `sse` only. Headers sent to the server, each valued from `agent-secrets`."
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The name of the header or environment variable."
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The key of the cluster's `agent-secrets` that holds its value."
                    }
                  },
                  "required": [
                    "name",
                    "ref"
                  ],
                  "additionalProperties": false
                },
                "description": "`stdio` only. Environment variables of the server's process, each valued from `agent-secrets`."
              }
            },
            "required": [
              "name",
              "transport"
            ],
            "additionalProperties": false
          },
          "description": "The MCP servers the agent can call."
        },
        "disallowed_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools the agent may not use."
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables of the agent, as plain values."
        },
        "permission_mode": {
          "type": "string",
          "enum": [
            "auto",
            "bypass"
          ],
          "description": "How the agent asks before it acts. Defaults to `bypass`."
        },
        "max_turns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The most turns the agent takes in one visit."
        },
        "model_secret_key": {
          "type": "string",
          "minLength": 1,
          "description": "The key of `agent-secrets` that holds the model's API key."
        },
        "pod_resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `500m`."
                },
                "memory": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `2Gi`."
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `6Gi`."
                }
              },
              "additionalProperties": false,
              "description": "What the pod asks for."
            },
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `500m`."
                },
                "memory": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `2Gi`."
                },
                "ephemeral-storage": {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$",
                  "description": "A Kubernetes quantity, such as `6Gi`."
                }
              },
              "additionalProperties": false,
              "description": "What the pod may not exceed."
            }
          },
          "additionalProperties": false,
          "description": "The resources of the agent's container. With none, the cluster's default applies."
        }
      },
      "additionalProperties": {},
      "description": "Settings for the agent's pod. A key the floor does not know is kept and not acted on."
    }
  },
  "additionalProperties": false
}
