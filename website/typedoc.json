{
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "entryPoints": [
    ".generated/released-station/node_modules/@re-cinq/floor-station/dist/index.d.ts"
  ],
  "tsconfig": "sdk/tsconfig.json",
  "out": ".generated/station",
  "router": "module",
  "entryFileName": "api.md",
  "readme": "none",
  "hidePageTitle": true,
  "hideBreadcrumbs": true,
  "disableSources": true,
  "jsDocCompatibility": {
    "exampleTag": false
  },
  "treatWarningsAsErrors": true,
  "hidePageHeader": true,
  "groupOrder": [
    "Functions",
    "Type Aliases",
    "Interfaces"
  ],
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table"
}
