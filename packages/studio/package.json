{
  "name": "@re-cinq/floor-studio",
  "version": "0.1.0",
  "description": "A local studio for a collection of assembly lines: a backend that reads the folder and tells every client over a WebSocket, a protocol of typed frames, and a command that serves the page and opens it.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-cinq/floor.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/re-cinq/floor/tree/main/packages/studio#readme",
  "bugs": {
    "url": "https://github.com/re-cinq/floor/issues"
  },
  "keywords": [
    "floor",
    "assembly-line",
    "collection",
    "studio",
    "cli"
  ],
  "type": "module",
  "bin": {
    "floor-studio": "dist/cli.js"
  },
  "exports": {
    "./backend": {
      "types": "./dist/backend/index.d.ts",
      "default": "./dist/backend/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "dev": "tsc --watch -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@re-cinq/floor-assembly-lines": "*",
    "@re-cinq/floor-contracts": "*",
    "@re-cinq/floor-pipeline": "*",
    "ws": "^8.22.0",
    "yaml": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
