{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "paths": { "@/*": ["./src/*"], "@protocol": ["../src/protocol.ts"] }
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
