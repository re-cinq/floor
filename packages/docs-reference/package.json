{
  "name": "@floor/docs-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Writes the parts of the website that are generated from the code: the field tables of the specifications, the JSON Schema files, and the examples shown on a page. A page that has drifted from the code fails the check.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "node dist/cli.js",
    "check": "node dist/cli.js --check"
  },
  "dependencies": {
    "@floor/api": "*",
    "@re-cinq/floor-pipeline": "*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
