# Copy to .env.local (never committed). Read by `npm run minikube-setup` and `npm run minikube-claude-auth`.

# The agent's model credential. One of the two; the API key wins when both are set.
# Leave both empty to use your own Claude subscription: `npm run minikube-claude-auth` runs
# `claude setup-token`, asks for the token, and writes it here.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# The ai-agent-subsystem's images are private: a GitHub token with read:packages, and its owner.
GHCR_USER=
GHCR_TOKEN=
