# Copy to .env.local (never committed). Read by scripts/setup-minikube-agents.sh.

# The agent's model credential. One of the two; the API key wins when both are set.
# Your own Claude subscription: run `claude setup-token` and paste what it prints.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# The ai-agent-subsystem's images are private: a GitHub token with read:packages, and its owner.
GHCR_USER=
GHCR_TOKEN=
